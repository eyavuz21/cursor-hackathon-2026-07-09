# Supabase (Person A — onboarding preferences)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Google Maps (explore + journal planner)
# Enable Places API, Maps JavaScript API, and Routes API on the server key.
GOOGLE_MAPS_API_KEY=your_server_key
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=your_browser_key

# LinkUp (shop planner live grocery prices — ParkAndSave integration)
LINKUP_API_KEY=your-linkup-key
